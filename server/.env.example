# OpenRouter API 配置模板
# 使用方法：
# 1. 复制本文件为 .env
# 2. 把 your_key_here 替换成你的真实 API Key
# 3. 不要把 .env 提交到 Git
#
# OPENROUTER_MODEL 常用值：
#   openrouter/free        免费模型随机路由
#   openrouter/auto        自动选择模型
#   deepseek/deepseek-chat DeepSeek 模型
#   openai/gpt-4o-mini     OpenAI 小模型
#
# 安全提醒：真实 Key 只保存在 server/.env，不要写进代码、截图或聊天记录。

OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME=StudyMate AI
OPENROUTER_SITE_URL=http://localhost:5500
